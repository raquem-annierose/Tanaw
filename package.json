{
  "name": "tanaw",
  "version": "0.1.0",
  "private": true,
  "description": "Tanaw: Café & City Lights, a cozy hilltop café hangout on Roblox by NieRa Studios",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raquem-annierose/Tanaw.git"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write . && stylua src",
    "format:check": "prettier --check . && stylua --check src",
    "lint": "selene src",
    "typecheck": "node scripts/check.cjs --only-types",
    "check": "node scripts/check.cjs",
    "bootstrap": "pnpm install && rokit install",
    "commitlint": "commitlint --from origin/main --to HEAD"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@johnnymorganz/stylua-bin"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@johnnymorganz/stylua-bin": "^2.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1"
  }
}
