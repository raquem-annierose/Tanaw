{
  "name": "tanaw",
  "version": "0.1.0",
  "private": true,
  "description": "Tanaw: a cozy hilltop café hangout on Roblox by NieRa Studios",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raquem-annierose/Tanaw.git"
  },
  "scripts": {
    "prepare": "husky",
