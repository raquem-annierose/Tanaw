    "commitlint": "commitlint --from origin/main --to HEAD"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@johnnymorganz/stylua-bin": "^2.6.0",
    "husky": "^9.1.7"
  }
}
